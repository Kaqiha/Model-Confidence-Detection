    "def plot(c,f):\n",
    "    con = torch.cat(c).numpy()\n",
    "    f1n = torch.cat(f).numpy()\n",
    "    bin = np.linspace(0,1,11)\n",
    "    order = np.digitize(con,bin)-1\n",
    "    af1 = []\n",
    "    aco = []\n",
    "    for i in range(10):\n",
    "        mask = order == i\n",
    "        if mask.sum() > 0:\n",
    "            af1.append(f1n[mask].mean())\n",
    "            aco.append(con[mask].mean())\n",
    "    plt.xlim(0,1)\n",
    "    plt.ylim(0,1)\n",
    "    plt.suptitle(\"Accuracy vs Confidence Calibration Curve\")\n",
    "    plt.xlabel(\"Confidence\")\n",
    "    plt.ylabel(\"Accuracy\")\n",
    "    plt.plot(aco,af1,'o-',label=\"Model Output\")\n",
    "    plt.plot([0,1],[0,1],'--',color='gray',label=\"Theoretical Output\")\n",
    "    plt.legend()"
